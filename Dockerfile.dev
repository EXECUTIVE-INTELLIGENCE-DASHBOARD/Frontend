# Local development container only — `docker compose up` runs the Vite dev
# server with hot reload. Never used in production: the repository-root
# `Dockerfile` builds and serves the production bundle from nginx.
FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
