# Base URL of the GreenHill EID Django backend, including the trailing /api.
# `src/lib/api/client.ts` strips any trailing slash, so either form works.
#
# Deployed backends (probed):
#   https://eid-backend-4mrm.onrender.com/api       — academics + procurement, has rows
#   https://greenhill-eid-backend.onrender.com/api  — academics + procurement, empty
#
# For a local Django server (`python manage.py runserver`):
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# Leave this unset to fall back to `defaultApiBaseUrl` in `src/lib/api/client.ts`.
VITE_API_BASE_URL=/api
VITE_API_URL=/api

# Base URL of the GreenHill identity provider (the auth backend).
#
# "Log out" hands the whole browser to this service, because the account
# session is shared with PMS and ISMP and only the provider can end it. When
# this is unset, `src/lib/api/core.ts` falls back to the production host.
#
# Local auth backend (`python manage.py runserver` in Auth-backend):
#   VITE_SSO_BASE_URL=http://127.0.0.1:8000
VITE_SSO_BASE_URL=https://greenhill-auth-backend2.onrender.com
