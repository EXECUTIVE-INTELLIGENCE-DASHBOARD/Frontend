# Base URL of the GreenHill EID Django backend, including the trailing /api.
# `src/lib/api/client.ts` strips any trailing slash, so either form works.
#
# Deployed backends (probed):
#   https://eid-backend-4mrm.onrender.com/api       — academics + procurement, has rows
#   https://greenhill-eid-backend.onrender.com/api  — academics + procurement, empty
#
# For local development you normally do not need this file at all: the committed
# `.env.development` already points at the local API. This template is for a
# machine that has to be aimed somewhere else.
#
# The local EID API runs on port 8001, not 8000. Port 8000 belongs to the
# identity provider, whose /api/... routes all answer 404, so pointing here at
# 8000 produces failures that look like a database outage:
#   VITE_API_BASE_URL=http://localhost:8001/api
#   VITE_API_URL=http://localhost:8001/api
#
# Start that server with the port explicit:
#   python manage.py runserver localhost:8001
# A bare `runserver` defaults to 8000 and, on Windows, binds it silently
# alongside the identity provider, leaving the API unreachable.
#
# Leave these unset to fall back to `defaultApiBaseUrl` in `src/lib/api/client.ts`.
VITE_API_BASE_URL=/api
VITE_API_URL=/api

# Base URL of the GreenHill identity provider (the auth backend).
#
# "Log out" hands the whole browser to this service, because the account
# session is shared with PMS and ISMP and only the provider can end it. When
# this is unset, `src/lib/api/core.ts` falls back to the production host.
#
# The local identity provider does run on port 8000, started as
# `python manage.py runserver 127.0.0.1:8000` in Auth-backend:
#   VITE_SSO_BASE_URL=http://127.0.0.1:8000
VITE_SSO_BASE_URL=https://greenhill-auth-backend2.onrender.com
