# Development only. In `npm run dev` the browser talks to the Vite server and
# Vite forwards /api to the Django backend (see server.proxy in vite.config.ts).
#
# Same-origin keeps three problems away:
#   1. no CORS preflight,
#   2. no cookie/authorisation surprises on a cross-site origin,
#   3. no browser DNS lookup — the network resolves the backend host, not the OS,
#      which is what produced net::ERR_NAME_NOT_RESOLVED.
#
# Production builds ignore this file and use `.env.production`, which also
# sets /api; nginx proxies that to the backend in the deployed container.
VITE_API_URL=/api
VITE_API_BASE_URL=/api
