{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "typecheck",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"typecheck"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "test",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"test"
			],
			"group": "test"
		}
	]
}